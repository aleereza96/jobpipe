# Optional. Copy to .env only if you need to change these defaults.
JOBPIPE_PORT=8787
TZ=UTC
# Optional exact version override. The default is the tested release in CODEX_VERSION.
# CODEX_VERSION=0.169.0
# Only needed for the alternative provider:
# ANTHROPIC_API_KEY=
# Only needed for the optional command-line email-alert collector:
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=

# Optional existing data folder instead of the default Docker volume.
# Use an absolute path or ./folder; Linux UID 1000 must be able to write to it.
# JOBPIPE_DATA_PATH=./my-data
# Optional network proxy (reachable from inside Docker, not a host-only localhost URL).
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
# Usually unnecessary; overrides an old machine-specific codex_command setting.
# Docker paths refer to the container, not the host.
# JOBPIPE_CODEX_COMMAND=/usr/local/bin/codex
