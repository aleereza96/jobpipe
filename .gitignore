# Track application files only. Local data and credentials are ignored by default.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/README.md
!/Dockerfile
!/compose.yaml
!/requirements.txt
!/ai_provider.py
!/cv_pdf.py
!/cv_review.py
!/cv_source.py
!/gmail_alerts.py
!/jobpipe.py
!/search_rank.py
!/server.py
!/sources.py
!/defaults/
/defaults/*
!/defaults/config.json
!/defaults/cv.md
!/tests/
/tests/*
!/tests/test_dashboard.py
!/tests/test_gmail_alerts.py
!/tests/test_pipeline.py
!/web/
/web/*
!/web/app.js
!/web/index.html
!/web/style.css

!/dedup.py

!/LICENSE
